{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "ESNext",
    "moduleResolution": "bundler",
    "lib":              ["ES2022", "DOM", "DOM.Iterable"],
    "jsx":              "react-jsx",
    "types":            ["vite/client"],
    "strict":           true,
    "skipLibCheck":     true,
    "noUncheckedIndexedAccess": true,
    "noEmit":           true,
    "baseUrl":          ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include":  ["src/**/*", "vite.config.ts"],
  "exclude":  ["node_modules"]
}
